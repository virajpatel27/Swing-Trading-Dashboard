# Copy this file to ".env" (same folder) and fill the values ONLY on your own PC.
# ".env" is in .gitignore, so it never goes to GitHub. Never share it, never screenshot it.
# On GitHub the same 4 names are set as Secrets (Settings -> Secrets and variables -> Actions).
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
