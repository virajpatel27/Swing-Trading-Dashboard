# Secrets and login sessions - never in git
.env
.env.*
!.env.example
*.session
*token*.json
session/
# smartapi-python writes its own log files here (may hold request details)
logs/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Local caches (downloaded again when needed)
cache/
data/meta/cache/

# Website build output (made inside GitHub Actions)
_site/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Written by every daily run (the run's summary is on its Actions page)
reports/daily_last.json

# Kept by restore.py before it replaces data/ (delete by hand once the restore looks right)
data_before_restore_*/
reports/integrity.*

# Google Drive one-time setup files (secrets: never commit)
client_secret*.json
gdrive_token.txt

# Third-party reference material (scanthecharts screenshots + exports): never publish (public repo)
reference/

# Screen snapshot: every indicator field per stock, rebuilt by the website workflow (changes completely every day,
# so keeping it in git would add ~100 MB a year). Calibration copies: screen_YYYY-MM-DD.json
data/snapshot/screen*.json
