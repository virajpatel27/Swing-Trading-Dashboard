      "value": 30
     },
     {
      "field": "from_hi52",
      "op": ">=",
      "value": -25
     },
     {
      "field": "rs_rating",
      "op": ">=",
      "value": 70
     }
    ]
   },
   "sort": {
    "field": "rs_rating",
    "dir": "desc"
   }
  },
  {
