  {
   "id": "20sma-pullback",
   "folder": "Classic",
   "name": "20-SMA Pullback",
   "description": "A strong month (up 15 % or more) pulling back to the 20-day average: close between 2 % below and 3 % above SMA20, SMA20 at least 2.5 % above EMA50, today's turnover Rs 10 Cr or more.",
   "universe": "all",
   "rule": {
    "all": [
     {
      "field": "ret_1m",
      "op": ">=",
      "value": 15
     },
     {
      "field": "from_sma20",
      "op": "between",
