      "op": ">",
      "value": 0
     },
     {
      "field": "sma50_chg_1m",
      "op": ">",
      "value": 0
     }
    ]
   },
   "sort": {
    "field": "rs_rating",
    "dir": "desc"
   },
   "phase": 7
  },
  {
