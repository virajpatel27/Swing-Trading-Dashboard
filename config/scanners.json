   "universe": "all",
   "rule": {
    "all": [
     {
      "field": "close",
      "op": ">",
      "field2": "sma150"
     },
     {
      "field": "close",
      "op": ">",
      "field2": "sma200"
     },
     {
      "field": "sma150",
      "op": ">",
      "field2": "sma200"
     },
