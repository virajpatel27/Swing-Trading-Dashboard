      "value": 70
     },
     {
      "field": "range_pct",
      "op": ">=",
      "field2": "adr_pct",
      "mult": 1.5
     }
    ]
   },
   "sort": {
    "field": "range_pct",
    "dir": "desc"
   },
   "phase": 7
  },
  {
   "id": "shakeout",
   "folder": "Patterns",
   "name": "Shakeout",
   "description": "An uptrend stock that dropped 4 %+ below its rising 50-day average in the last 5 sessions and is already back above it.",
