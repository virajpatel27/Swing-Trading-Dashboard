 "vs Sector 1M %", "vs_industry_1m": "vs Industry 1M %", "themes": "Themes", "theme": "Top theme", "theme_status": "Theme status"}, "scanners": [{"id": "all-stocks", "folder": "My Scans", "name": "All Stocks", "description": "Every stock, no test. Start here and add your own conditions with Formula.", "universe": "all", "rule": {"all": []}, "sort": {"field": "rs_rating", "dir": "desc"}}, {"id": "trend-template", "folder": "Classic", "name": "Trend Template", "description": "A healthy uptrend: above rising long averages, the averages stacked in order, well off the lows, near the highs and stronger than most stocks (Minervini's checklist).", "universe": "all", "rule": {"all": [{"field": "close", "op": ">", "field2": "sma150"}, {"field": "close", "op": ">", "field2": "sma200"}, {"field": "sma150", "op": ">", "field2": "sma200"}, {"field": "sma200_chg_1m", "op": ">", "value": 0}, {"field": "sma50", "op": ">", "field2": "sma150"}, {"field": "sma50", "op": ">", "field2": "sma200"}, {"field": "close", "op": ">", "field2": "sma50"}, {"field": "from_lo52", "op": ">=", "value": 30}, {"field": "from_hi52", "op": ">=", "value": -25}, {"field": "rs_rating", "op": ">=", "value": 70}]}, "sort": {"field": "rs_rating", "dir": "desc"}}, {"id": "stage2-breakout", "folder": "Classic", "name": "Stage 2 Breakout", "description": "Broke out in the last 6 sessions: close above the highest high of the 50 sessions before, on 2 x the usual volume, close near the day's high, in Stage 2.", "universe": "all", "rule": {"all": [{"field": "s2b_age", "op": "<=", "value": 6}]}, "sort": {"field": "s2b_age", "dir": "asc"}}, {"id": "4pct-breakout", "folder": "Classic", "name": "4% Breakout", "description": "A strong up day (+4 % or more) on volume above yesterday's and well above the 20-day average. Liquid stocks only.", "universe": "liquid", "rule": {"all": [{"field": "chg_1d", "op": ">=", "value": 4}, {"field": "vol_chg_1d", "op": ">", "value": 0}, {"field": "rvol", "op": ">=", "value": 1.5}]}, "sort": {"field": "chg_1d", "dir": "desc"}}, {"id": "20sma-pullback", "folder": "Classic", "name": "20-SMA Pullback", "description": "A strong month (up 15 % or more) pulling back to the 20-day average: close between 2 % below and 3 % above SMA20, SMA20 at least 2.5 % above EMA50, today's turnover Rs 10 Cr or more.", "universe": "all", "rule": {"all": [{"field": "ret_1m", "op": ">=", "value": 15}, {"field": "from_sma20", "op": "between", "value": [-2, 3]}, {"field": "sma20", "op": ">=", "field2": "ema50", "mult": 1.025}, {"field": "turnover_cr", "op": ">=", "value": 10}]}, "sort": {"field": "rs_rating", "dir": "desc"}}, {"id": "high-volume", "folder": "Classic", "name": "High Volume", "description": "A high-volume up day in the last 5 sessions: up 2 x its usual daily range or more, close near the day's high, the biggest volume of the last quarter (63 sessions), no bigger volume day since.", "universe": "all", "rule": {"all": [{"field": "hv_age", "op": "<=", "value": 5}]}, "sort": {"field": "hv_age", "dir": "asc"}}, {"id": "1m-gainers", "folder": "Classic", "name": "1M Gainers", "description": "Up 20 % or more in the last month (21 sessions); today's turnover Rs 5 Cr or more, price Rs 20 or more.", "universe": "all", "rule": {"all": [{"field": "ret_1m", "op": ">=", "value": 20}, {"field": "turnover_cr", "op": ">=", "value": 5}, {"field": "close", "op": ">=", "value": 20}]}, "sort": {"field": "ret_1m", "dir": "desc"}}, {"id": "3m-gainers", "folder": "Classic", "name": "3M Gainers", "description": "Up 30 % or more in 3 months (63 sessions), in Stage 2 or 3; today's turnover Rs 5 Cr or more, price Rs 20 or more, market cap under Rs 1 lakh Cr.", "universe": "all", "rule": {"all": [{"field": "ret_3m", "op": ">=", "value": 30}, {"field": "stage", "op": "in", "value": ["2", "2A", "3"]}, {"field": "turnover_cr", "op": ">=", "value": 5}, {"field": "close", "op": ">=", "value": 20}, {"field": "mcap_cr", "op": "<", "value": 100000}]}, "sort": {"field": "ret_3m", "dir": "desc"}}, {"id": "outperformers", "folder": "Classic", "name": "Outperformers", "description": "Strong against all other stocks over 1 week, 1 month and 3 months at the same time. Liquid stocks only.", "universe": "liquid", "rule": {"all": [{"field": "rs_rating_1w", "op": ">", "value": 90}, {"field": "rs_rating_1m", "op": ">", "value": 85}, {"field": "rs_rating_3m", "op": ">", "value": 80}]}, "sort": {"field": "rs_rating", "dir": "desc"}}, {"id": "doublers", "folder": "Classic", "name": "Doublers", "description": "Doubled (up 100 % or more) in the last year (251 sessions); today's turnover Rs 5 Cr or more.", "universe": "all", "rule": {"all": [{"field": "ret_1y", "op": ">=", "value": 100}, {"field": "turnover_cr", "op": ">=", "value": 5}]}, "sort": {"field": "ret_6m", "dir": "desc"}}, {"id": "new-listing", "folder": "Classic", "name": "New Listing", "description": "Came to NSE's main board through an IPO 28 to 365 days ago (NSE's IPO list).", "universe": "all", "rule": {"all": [{"field": "days_since_ipo", "op": "between", "value": [28, 365]}]}, "sort": {"field": "days_since_ipo", "dir": "asc"}}, {"id": "50ema-pullback", "folder": "Patterns", "name": "50-EMA Pullback", "description": "A big 6-month winner (up 40 % or more, still up over 3 months, at most +5 % in the last month) back at its 50-day EMA (within 3 %), with EMA50 at least 20 % above SMA200; today's turnover Rs 10 Cr or more.", "universe": "all", "rule": {"all": [{"field": "ret_6m", "op": ">=", "value": 40}, {"field": "ret_3m", "op": ">", "value": 0}, {"field": "ret_1m", "op": "<=", "value": 5}, {"field": "from_ema50", "op": "between", "value": [-3, 3]}, {"field": "ema50", "op": ">=", "field2": "sma200", "mult": 1.2}, {"field": "turnover_cr", "op": ">=", "value": 10}]}, "sort": {"field": "rs_rating", "dir": "desc"}}, {"id": "new-rs-before-price", "folder": "Patterns", "name": "New RS before Price", "description": "The RS line (vs Nifty MidSmallcap 400) made a new 50-session high today while the price is still 0-10 % und