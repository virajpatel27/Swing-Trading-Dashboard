 "Classic", "name": "Stage 2 Breakout", "description": "Traded above the highest high of the 50 days before, on at least 1.5 times the usual volume, while basing or in an uptrend.", "universe": "all", "rule": {"all": [{"field": "high", "op": ">", "field2": "high_50d_prev"}, {"field": "rvol", "op": ">=", "value": 1.5}, {"field": "stage", "op": "in", "value": ["1", "2", "2A"]}]}, "sort": {"field": "rvol", "dir": "desc"}}, {"id": "4pct-breakout", "folder": "Classic", "name": "4% Breakout", "description": "A strong up day (+4 % or more) on volume above yesterday's and well above the 20-day average. Liquid stocks only.", "universe": "liquid", "rule": {"all": [{"field": "chg_1d", "op": ">=", "value": 4}, {"field": "vol_chg_1d", "op": ">", "value": 0}, {"field": "rvol", "op": ">=", "value": 1.5}]}, "sort": {"field": "chg_1d", "dir": "desc"}}, {"id": "20sma-pullback", "folder": "Classic", "name": "20-SMA Pullback", "description": "A strong month (up 15 % or more) pulling back to the 20-day average: close between 2 % below and 3 % above SMA20, SMA20 at least 2.5 % above EMA50, today's turnover Rs 10 Cr or more.", "universe": "all", "rule": {"all": [{"field": "ret_1m", "op": ">=", "value": 15}, {"field": "from_sma20", "op": "between", "value": [-2, 3]}, {"field": "sma20", "op": ">=", "field2": "ema50", "mult": 1.025}, {"field": "turnover_cr", "op": ">=", "value": 10}]}, "sort": {"field": "rs_rating", "dir": "desc"}}, {"id": "high-volume", "folder": "Classic", "name": "High Volume", "description": "A high-volume up day in the last 5 sessions: up 2 x its usual daily range or more, close near the day's high, the biggest volume of the last quarter (63 sessions), no bigger volume day since.", "universe": "all", "rule": {"all": [{"field": "hv_age", "op": "<=", "value": 5}]}, "sort": {"field": "hv_age", "dir": "asc"}}, {"id": "1m-gainers", "folder": "Classic", "name": "1M Gainers", "description": "Up 20 % or more in the last month (21 sessions); today's turnover Rs 5 Cr or more, price Rs 20 or more.", "universe": "all", "rule": {"all": [{"field": "ret_1m", "op": ">=", "value": 20}, {"field": "turnover_cr", "op": ">=", "value": 5}, {"field": "close", "op": ">=", "value": 20}]}, "sort": {"field": "ret_1m", "dir": "desc"}}, {"id": "3m-gainers", "folder": "Classic", "name": "3M Gainers", "description": "Up 30 % or more in 3 months (63 sessions), in Stage 2 or 3; today's turnover Rs 5 Cr or more, price Rs 20 or more, market cap under Rs 1 lakh Cr.", "universe": "all", "rule": {"all": [{"field": "ret_3m", "op": ">=", "value": 30}, {"field": "stage", "op": "in", "value": ["2", "2A", "3"]}, {"field": "turnover_cr", "op": ">=", "value": 5}, {"field": "close", "op": ">=", "value": 20}, {"field": "mcap_cr", "op": "<", "value": 100000}]}, "sort": {"field": "ret_3m", "dir": "desc"}}, {"id": "outperformers", "folder": "Classic", "name": "Outperformers", "description": "Strong against all other stocks over 1 week, 1 month and 3 months at the same time. Liquid stocks only.", "universe": "liquid", "rule": {"all": [{"field": "rs_rating_1w", "op": ">", "value": 90}, {"field": "rs_rating_1m", "op": ">", "value": 85}, {"field": "rs_rating_3m", "op": ">", "value": 80}]}, "sort": {"field": "rs_rating", "dir": "desc"}}, {"id": "doublers", "folder": "Classic", "name": "Doublers", "description": "Doubled (up 100 % or more) in the last year (251 sessions); today's turnover Rs 5 Cr or more.", "universe": "all", "rule": {"all": [{"field": "ret_1y", "op": ">=", "value": 100}, {"field": "turnover_cr", "op": ">=", "value": 5}]}, "sort": {"field": "ret_6m", "dir": "desc"}}, {"id": "new-listing", "folder": "Classic", "name": "New Listing", "description": "Came to NSE's main board through an IPO 28 to 365 days ago (NSE's IPO list).", "universe": "all", "rule": {"all": [{"field": "days_since_ipo", "op": "between", "value": [28, 365]}]}, "sort": {"field": "days_since_ipo", "dir": "asc"}}, {"id": "50ema-pullback", "folder": "Patterns", "name": "50-EMA Pullback", "description": "A big 6-month winner (up 40 % or more, still up over 3 months, at most +5 % in the last month) back at its 50-day EMA (within 3 %), with EMA50 at least 20 % above SMA200; today's turnover Rs 10 Cr or more.", "universe": "all", "rule": {"all": [{"field": "ret_6m", "op": ">=", "value": 40}, {"field": "ret_3m", "op": ">", "value": 0}, {"field": "ret_1m", "op": "<=", "value": 5}, {"field": "from_ema50", "op": "between", "value": [-3, 3]}, {"field": "ema50", "op": ">=", "field2": "sma200", "mult": 1.2}, {"field": "turnover_cr", "op": ">=", "value": 10}]}, "sort": {"field": "rs_rating", "dir": "desc"}}, {"id": "new-rs-before-price", "folder": "Patterns", "name": "New RS before Price", "description": "The RS line (vs Nifty Smallcap 250) reached a new 52-week high in the last 7 sessions while the price is not at its 52-week high: strength showing before a breakout.", "universe": "all", "rule": {"all": [{"field": "rs_high_days", "op": "<=", "value": 7}, {"field": "days_since_hi52", "op": ">", "value": 0}]}, "sort": {"field": "rs_rating", "dir": "desc"}}, {"id": "recent-breakout", "folder": "Classic", "name": "Recent Breakout", "description": "Broke out of a base that lasted at least 40 sessions, on 2x+ volume, within the last 10 sessions, and is still above the old pivot. Liquid stocks only.", "universe": "liquid", "rule": {"all": [{"field": "breakout_days", "op": "<=", "value": 10}, {"field": "breakout_rvol", "op": ">=", "value": 2}, {"field": "breakout_base_age", "op": ">=", "value": 40}, {"field": "close", "op": ">", "field2": "breakout_level"}]}, "sort": {"field": "breakout_days", "dir": "asc"}, "phase": 7}, {"id": "daily-base", "folder": "Patterns", "name": "Daily Base", "description": "A young base (3 weeks to about 4 months) after a 15 %+ rise, at most 35 % deep, with the price back within 15 % of the top and no breakout yet.", "universe": "all", "rule": {"all": [{"field": "pivot_age", "op": "between", "value": [15, 90]}, {"field": "base_depth", "op": "<=", "value": 35}, {"field": "dist_pivot", "op": ">=", "value": -15}, {"field": "base_prior_gain", "op": ">=", "value": 15}]}, "sort": {"field": "dist_pivot", "dir": "desc"}, "phase": 7}, {"id": "weekly-base", "folder": "Patterns", "name": "Weekly Base", "description": "A long base (about 4 to 18 months), at most 55 % deep, with the price back within 16 % of its top and no breakout yet.", "universe": "all", "rule": {"all": [{"field": "pivot_w_age", "op": "between", "value": [85, 390]}, {"field": "base_w_depth", "op": "<=", "value": 55}, {"field": "dist_pivot_w", "op": ">=", "value": -16}]}, "sort": {"field": "dist_pivot_w", "dir": "desc"}, "phase": 7}, {"id": "near-pivot", "folder": "Patterns", "name": "Near Pivot", "description": "Just under the pivot of its base: closer than one usual daily range (ADR %).", "universe": "all", "rule": {"all": [{"field": "dist_pivot", "op": ">=", "field2": "adr_pct", "mult": -1}]}, "sort": {"field": "dist_pivot", "dir": "desc"}, "phase": 7}, {"id": "vcp", "folder": "Patterns", "name": "VCP", "description": "Volatility contraction: at least 2 pullbacks in a row inside the base, each smaller than the one before, the last one at most 8 %, in an uptrend within 5 % of the pivot.", "universe": "all", "rule": {"all": [{"field": "vcp_contractions", "op": ">=", "value": 2}, {"field": "vcp_last_pct", "op": "<=", "value": 8}, {"field": "stage", "op": "in", "value": ["2", "2A"]}, {"field": "dist_pivot", "op": ">=", "value": -5}]}, "sort": {"field": "dist_pivot", "dir": "desc"}, "phase": 7}, {"id": "tight-range", "folder": "Patterns", "name": "Tight Range", "description": "Very quiet trading inside an uptrend: the last 5 closes within 1.5 % of each other.", "universe": "all", "rule": {"all": [{"field": "stage", "op": "in", "value": ["2", "2A"]}, {"field": "tight_pct", "op": "<=", "value": 1.5}]}, "sort": {"field": "tight_pct", "dir": "asc"}, "phase": 7}, {"id": "flag", "folder": "Patterns", "name": "Flag Pattern", "description": "A sharp rise (the pole, 40 %+ in